# Sentari configuration.  Copy to `.env` (which is gitignored) and fill in only what you need:
#     cp .env.example .env
# Real environment variables override this file. Empty values are ignored. Never commit real keys.
# Everything is OPTIONAL for local/offline use: with no .env at all, Sentari runs on the bundled
# synthetic sample data with SQLite and the offline (heuristic) agents.

# ---------------------------------------------------------------- database
# Default is a local SQLite file. Postgres example (docker-compose / Cloud SQL):
# DATABASE_URL=postgresql+psycopg2://sentari:sentari@localhost:5432/sentari
DATABASE_URL=

# ---------------------------------------------------------------- LLM agents (bull / bear / judge)
# Without a key the agents run offline with a deterministic heuristic backend ($0).
# Get one at https://console.anthropic.com  ->  API keys (needs prepaid credit; set a spend limit).
ANTHROPIC_API_KEY=
# Force the offline agents even if a key is present (useful for tests and cost control):
# SENTARI_LLM=heuristic
# SENTARI_LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- data sources
# SEC EDGAR REQUIRES a contact in the User-Agent: "Your Name your.email@example.com".
# No signup; you choose what contact to expose. Used by the sec_edgar (and other) scrapers.
SENTARI_USER_AGENT=
# Earnings-call transcript provider key: NOT USED YET. Reserved for the real transcript scraper,
# which is built once you choose a provider (see README "Getting real data").
# TRANSCRIPT_API_KEY=

# ---------------------------------------------------------------- models / evaluation
# Which model serves predictions. Default: whichever the model registry marks `serving`,
# else `lm_directional`. Options: vader sentiwordnet lm_lexicon lm_directional nb_tfidf dt_tfidf cnn lstm
# finbert_zeroshot finbert_ft
# SENTARI_MODEL=lm_directional
# Use a transformer NLI model for the Skeptic's entailment check (recommended; downloads ~180 MB once):
# SENTARI_NLI=hf
# Base checkpoint for the transformer rung (default ProsusAI/finbert):
# SENTARI_BASE_MODEL=ProsusAI/finbert
# Sentence-transformers embeddings instead of the built-in hashing embedder (needs `pip install sentence-transformers`):
# SENTARI_EMBEDDER=st
# Path to a GloVe file (e.g. glove.6B.100d.txt) to initialise the CNN/LSTM embeddings:
# SENTARI_GLOVE=
# Where trained weights and the raw-response cache live:
# SENTARI_ARTIFACTS=artifacts
# SENTARI_CACHE_DIR=data/cache
# MLflow server (default: local ./mlruns file store):
# MLFLOW_TRACKING_URI=http://localhost:5000
# Optional Hugging Face token (only for rate limits / private models; FinBERT is public):
# HF_TOKEN=

# ---------------------------------------------------------------- delivery (daily digest)
# Slack: https://api.slack.com/apps -> Create app -> Incoming Webhooks -> Add new webhook to workspace.
SLACK_WEBHOOK_URL=
# Email via SMTP (Gmail: smtp.gmail.com / 587 with an App Password - requires 2-step verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=

# ---------------------------------------------------------------- deployment
# Shared secret Cloud Scheduler sends in the X-Cron-Token header to POST /run/daily.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTARI_CRON_TOKEN=
# Comma-separated browser origins allowed to call the API (your dashboard URL). Default: *
CORS_ORIGINS=

# The dashboard has its own file: dashboard/.env.local (gitignored)
#     NEXT_PUBLIC_API_URL=http://localhost:8000
